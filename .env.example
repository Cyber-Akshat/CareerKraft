PORT=3000
APP_URL=http://localhost:3000
# MySQL 8.0.16+: create this database/user first (see AUTH-SETUP.md).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=careerkraft
DB_USER=careerkraft
DB_PASSWORD=
# Alternatively set DATABASE_URL=mysql://user:password@host:3306/careerkraft
# URL-encode special characters in URL credentials. DATABASE_URL takes precedence.
# For a remote server requiring TLS, enable certificate verification:
# DB_SSL=true
# DB_SSL_CA=C:/path/to/ca-certificate.pem
# Or quote the complete PEM certificate inline (literal \n or actual newlines):
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\nYOUR CA CERTIFICATE BODY\n-----END CERTIFICATE-----"
# A supplied CA also enables TLS; certificate and hostname verification stay enabled.
# On Render, add a Secret File and use DB_SSL_CA=/etc/secrets/aiven-ca.pem.
MAIL_MODE=preview
# Use MAIL_MODE=emailjs for EmailJS + your connected Gmail account (no owned domain).
# See EMAILJS-SETUP.md for template and Account > Security settings.
EMAILJS_SERVICE_ID=
# An existing EMAIL_SERVICE_ID is also accepted as the service ID.
EMAILJS_TEMPLATE_ID=
# Optional separate password-reset template; defaults to EMAILJS_TEMPLATE_ID.
EMAILJS_RESET_TEMPLATE_ID=
# An existing EMAILJS_TEMPLATE_ID1 is also accepted for the reset template.
EMAILJS_PUBLIC_KEY=
# Existing PUBLIC_API_KEY is also accepted for the EmailJS public key.
# Optional; recommended. Required if enabled for API authorization in EmailJS.
EMAILJS_PRIVATE_KEY=
# Existing PRIVATE_API_KEY is also accepted for the EmailJS private key.
# Alternatively use MAIL_MODE=brevo for Brevo's HTTPS API.
# Keep these defaults for local development. Public hosting requires
# NODE_ENV=production and an HTTPS APP_URL.
AUTH_SESSION_IDLE_MINUTES=30
AUTH_SESSION_MAX_AGE_HOURS=24
# Set only when behind a proxy you control; never use true or an arbitrary hop count.
# TRUST_PROXY=127.0.0.1,::1
# BREVO is also accepted for an existing API key.
BREVO_API_KEY=
# Brevo only: register and verify this sender. EmailJS uses its connected account.
MAIL_FROM=CareerKraft <hello@example.com>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GROQ_API_KEY=
GROQ_API_KEY1=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
